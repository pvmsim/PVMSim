# Generated PVMSim outputs
# Keep generated run and export artifacts locally; do not track them in Git.
/outputs/runs/*
/outputs/exports/*

# Preserve the empty output directory structure in the repository.
!/outputs/runs/.gitkeep
!/outputs/exports/.gitkeep

# MATLAB temporary, autosave, and generated-code files
*.asv
*.autosave
*.m~
slprj/
codegen/

# Operating-system files
.DS_Store
Thumbs.db
